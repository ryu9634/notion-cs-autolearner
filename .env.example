# ─── Notion ───────────────────────────────────────────────
# Integration 토큰: https://www.notion.so/profile/integrations 에서 발급
# 발급 후 반드시 대상 DB 페이지에서 "Connect" 해줘야 한다 (안 하면 403).
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# DB ID: Notion DB URL 의 32자 hex 부분
NOTION_DB_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Data Source ID: scripts/verify-notion.sh 가 출력해준다.
# (Notion API 2025 버전부터 DB 안에 data source 개념이 생겼다)
NOTION_DS_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ─── Anthropic ────────────────────────────────────────────
# 로컬에서 `claude /login` 으로 구독 인증했으면 생략 가능.
# GitHub Actions 에서는 필수 (구독 인증이 안 되므로 종량과금 API 키를 쓴다).
ANTHROPIC_API_KEY=sk-ant-xxxxx
